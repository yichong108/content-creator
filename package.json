{
  "name": "contentcreator",
  "private": true,
  "scripts": {
    "setup": "pnpm install && pnpm --dir apps/api setup",
    "setup:py": "pnpm --dir apps/api setup",
    "lock:py": "pnpm --dir apps/api lock",
    "db:up": "docker compose up -d mysql",
    "db:down": "docker compose down",
    "prepare": "husky",
    "dev": "turbo dev",
    "dev:api": "turbo dev --filter=api",
    "dev:ui": "turbo dev --filter=web --filter=admin",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "format": "turbo format",
    "format:check": "turbo format:check",
    "screenshot:chat": "pnpm --dir apps/web screenshot:chat"
  },
  "lint-staged": {
    "apps/web/**/*.{ts,tsx,md,json}": [
      "pnpm --dir apps/web exec prettier --write",
      "pnpm --dir apps/web exec eslint --fix"
    ],
    "apps/admin/**/*.{ts,tsx,md,json}": [
      "pnpm --dir apps/admin exec prettier --write",
      "pnpm --dir apps/admin exec eslint --fix"
    ],
    "apps/api/**/*.py": "node apps/api/scripts/ruff-staged.mjs"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.1.0",
    "turbo": "^2.5.4"
  },
  "packageManager": "pnpm@11.0.9",
  "engines": {
    "node": ">=20"
  }
}
